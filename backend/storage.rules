rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // ============================================
    // Helper Functions
    // ============================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function isPro() {
      let user = firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
      return user.subscription.status == 'active' && user.subscription.plan != 'free';
    }
    
    function isValidFileSize() {
      // Free: 10MB, Pro: 100MB
      let maxSize = isPro() ? 100 * 1024 * 1024 : 10 * 1024 * 1024;
      return request.resource.size <= maxSize;
    }
    
    // ============================================
    // User Files
    // ============================================
    
    match /users/{userId}/files/{fileId} {
      // Users can read their own files
      allow read: if isAuthenticated() && isOwner(userId);
      
      // Users can upload files (with size limits)
      allow write: if isAuthenticated() && 
        isOwner(userId) && 
        isValidFileSize();
      
      // Users can delete their own files
      allow delete: if isAuthenticated() && isOwner(userId);
    }
    
    // ============================================
    // Thumbnails (Server-generated)
    // ============================================
    
    match /thumbnails/{userId}/{fileId} {
      // Users can read their own thumbnails
      allow read: if isAuthenticated() && isOwner(userId);
      
      // Only server can write thumbnails
      allow write: if false;
    }
    
    // ============================================
    // Temporary Files (Auto-delete after 24h)
    // ============================================
    
    match /temp/{userId}/{fileId} {
      // Users can read/write/delete their temp files
      allow read, write, delete: if isAuthenticated() && isOwner(userId);
    }
  }
}
